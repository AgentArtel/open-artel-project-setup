# Server Configuration
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# GitHub API
# Required: Create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo (for private repos), read:org (for org repos)
GITHUB_TOKEN=ghp_your_github_token_here

# Kimi/Moonshot API
# Required: Get API key from https://platform.moonshot.cn/
# Required for /api/kimi/chat endpoint
KIMI_API_KEY=sk_your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Logging
LOG_LEVEL=info
