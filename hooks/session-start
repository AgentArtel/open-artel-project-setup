#!/usr/bin/env bash
# =============================================================================
# Open Artel — Session Start Hook
# =============================================================================
#
# Reads .ai/board.md, active tasks, and lessons.md and outputs a coordination
# context summary. Designed to be run at the start of every agent session.
#
# Usage:
#   ./hooks/session-start              # Print context to stdout
#   source <(./hooks/session-start)    # Source into shell (for scripts)
#
# For Claude Code hook integration, this outputs JSON with additionalContext.
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

AI_DIR="$PROJECT_ROOT/.ai"

# ---------------------------------------------------------------------------
# Gather coordination state
# ---------------------------------------------------------------------------

BOARD=""
ACTIVE_TASKS=""
LESSONS=""
TASK_COUNT=0

# Read board
if [ -f "$AI_DIR/board.md" ]; then
    BOARD=$(cat "$AI_DIR/board.md")
fi

# Read active tasks (IN_PROGRESS or REVIEW status)
if [ -d "$AI_DIR/tasks" ]; then
    for task_file in "$AI_DIR/tasks"/TASK-*.md; do
        [ -f "$task_file" ] || continue
        if grep -q '^\- \*\*Status\*\*: \(IN_PROGRESS\|REVIEW\|BLOCKED\)' "$task_file" 2>/dev/null; then
            ACTIVE_TASKS="${ACTIVE_TASKS}
---
$(head -30 "$task_file")"
            TASK_COUNT=$((TASK_COUNT + 1))
        fi
    done
fi

# Read lessons (just the entries, skip the header)
if [ -f "$AI_DIR/lessons.md" ]; then
    LESSONS=$(sed -n '/^## Entries/,$ p' "$AI_DIR/lessons.md" | tail -n +3)
fi

# ---------------------------------------------------------------------------
# Output context
# ---------------------------------------------------------------------------

cat << CONTEXT
# Session Context (auto-generated by hooks/session-start)

## Current Coordination Board
${BOARD:-"No board.md found. Create .ai/board.md to track who's doing what."}

## Active Tasks (${TASK_COUNT} in progress)
${ACTIVE_TASKS:-"No active tasks found."}

## Lessons Learned
${LESSONS:-"No lessons recorded yet."}

## Reminders
- Update .ai/board.md when you start, finish, or get blocked on work
- Follow the pipeline: brainstorm → plan → execute → verify
- No completion claims without fresh verification evidence
- Define each concept once — reference, don't restate
CONTEXT
